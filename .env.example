# ==============================================================================
# ROADRESQ ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Safe to expose in browser bundle)
# ------------------------------------------------------------------------------

# Firebase Web App Config (Found in Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=roadresq-live.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=roadresq-live
VITE_FIREBASE_STORAGE_BUCKET=roadresq-live.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Maps & Geocoding Provider
VITE_MAP_PROVIDER=osm
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Application Environment
VITE_APP_ENV=production
VITE_ENABLE_DEMO_CONTROLS=true

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (NEVER expose to client bundle / NEVER prefix with VITE_)
# ------------------------------------------------------------------------------

# Firebase Admin Service Account Key (for Cloud Functions / Vercel Serverless)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"roadresq-live"}

# AI Engine API Secret (Gemini / OpenAI / Groq)
AI_API_SECRET_KEY=your-secure-ai-api-key

# Razorpay / Stripe Payment Gateway Secrets
PAYMENT_GATEWAY_KEY_ID=rzp_live_xxxxxxxx
PAYMENT_GATEWAY_KEY_SECRET=your-secret-payment-key
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret

# SMS / WhatsApp Notification Gateway (Twilio / Fast2SMS)
SMS_GATEWAY_AUTH_TOKEN=your-sms-api-token
WHATSAPP_BUSINESS_TOKEN=your-meta-whatsapp-token
